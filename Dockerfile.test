# Test Dockerfile for DevPocket Server - Optimized for caching
FROM python:3.11-slim AS base

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Install system dependencies in one layer with minimal packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libffi-dev \
    libssl-dev \
    curl \
    tmux \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create test user
RUN groupadd -r testuser && useradd -r -g testuser -s /bin/bash -d /app testuser

# Set working directory
WORKDIR /app

# Copy and install Python dependencies first (better caching)
COPY requirements.txt requirements-test.txt ./
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir -r requirements-test.txt

# Copy application code
COPY app/ ./app/
COPY tests/ ./tests/
COPY pytest.ini ./

# Create necessary directories and set permissions
RUN mkdir -p /app/htmlcov /app/logs && \
    chown -R testuser:testuser /app

# Switch to test user
USER testuser

# Default command
CMD ["pytest", "tests/", "-v", "--cov=app", "--cov-report=html", "--cov-report=term-missing"]
